<div class="admin-card">
    <div class="admin-card-body">
        <form method="GET" action="/admin/picks/games">
            <div class="admin-form-group">
                <label for="week">@lang('picks.filter_week')</label>
                <select id="week" name="week" class="admin-input input-lg">
                    <option value="0">@lang('picks.all_rounds')</option>
                    @each ($weeks as $week)
                    <option value="{{ $week['id'] }}" @if((int) $week['id'] === (int) $weekId)selected @endif>{{ $week['label'] }}</option>
                    @endeach
                </select>
            </div>

            <div class="admin-form-group">
                <label for="status">@lang('picks.filter_status')</label>
                <select id="status" name="status" class="admin-input input-sm">
                    <option value="">@lang('picks.all_states')</option>
                    <option value="scheduled" @if($status === 'scheduled')selected @endif>@lang('picks.status_scheduled')</option>
                    <option value="closed" @if($status === 'closed')selected @endif>@lang('picks.status_closed')</option>
                    <option value="in_progress" @if($status === 'in_progress')selected @endif>@lang('picks.status_in_progress')</option>
                    <option value="finished" @if($status === 'finished')selected @endif>@lang('picks.status_finished')</option>
                </select>
            </div>

            <div class="admin-form-group">
                <label for="q">@lang('picks.filter_search')</label>
                <input type="text" id="q" name="q" class="admin-input input-lg" autocomplete="off" value="{{ $search }}">
            </div>

            <button type="submit" class="admin-btn admin-btn-sm">@lang('picks.filter_apply')</button>
        </form>

        <p class="admin-hint">@choice('picks.games_total', $total)</p>
    </div>
</div>

