<div class="admin-card">
    <div class="admin-card-body">
        <div class="admin-empty">
            <div class="admin-empty-title">@lang('picks.no_teams')</div>
            <div class="admin-empty-note">@lang('picks.no_teams_note')</div>
        </div>
