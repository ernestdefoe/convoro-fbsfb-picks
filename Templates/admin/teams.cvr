</div>

<div class="admin-card">
    <div class="admin-card-body">
        <form method="GET" action="/admin/picks/teams">
            <div class="admin-form-group">
                <label for="conference">@lang('picks.col_conference')</label>
                <select id="conference" name="conference" class="admin-input input-lg">
                    <option value="">@lang('picks.any_conference')</option>
                    @each ($conferences as $option)
                    <option value="{{ $option }}" @if($option === $conference)selected @endif>{{ $option }}</option>
                    @endeach
                </select>
            </div>

            <div class="admin-form-group">
                <label for="q">@lang('picks.col_team')</label>
                <input type="text" id="q" name="q" class="admin-input input-lg" autocomplete="off" value="{{ $search }}">
            </div>

            <button type="submit" class="admin-btn admin-btn-sm">@lang('picks.filter_apply')</button>
        </form>
    </div>
</div>

