<form method="POST" action="/admin/picks/settings">
    @csrf

    <div class="admin-card">
        <div class="admin-card-header">@lang('picks.settings_heading')</div>
        <div class="admin-card-body">
            <div class="admin-form-group">
                <label class="admin-checkbox-label">
                    <input type="checkbox" name="picks_enabled" value="1" @if($settings->enabled())checked @endif>
                    @lang('picks.setting_enabled')
                </label>
                <div class="form-hint">@lang('picks.setting_enabled_note')</div>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card-header">@lang('picks.api_heading')</div>
        <div class="admin-card-body">
            <p class="admin-hint">@lang('picks.api_note')</p>

            {#
                🚨 There is no `value` here and there never may be.

                A stored credential printed back into a form is a credential in
                a browser cache, in a screenshot, and in the support ticket that
                screenshot is attached to. The box only ever says whether one
                exists, through the placeholder, and a blank box means "leave it
                alone" — clearing it is the separate button below.

                🚨 `text`, not `password`. Nothing is exposed by that: the box
                is empty on every load whether or not a key is stored. The
                password-manager hints are off because this credential belongs
                to a data provider rather than to the administrator's account,
                and offering to save it as a login here is both wrong and a
                popup to dismiss on every visit.
            #}
            <div class="admin-form-group">
                <label for="picks_cfbd_key">@lang('picks.setting_key')</label>
                <input type="text" id="picks_cfbd_key" name="picks_cfbd_key"
                       class="admin-input input-lg" autocomplete="off"
                       data-1p-ignore data-lpignore="true" data-form-type="other"
                       placeholder="@if($settings->hasCfbdKey())@lang('picks.unchanged')@endif">
                <div class="form-hint">@lang('picks.setting_key_note')</div>
            </div>
        </div>
    </div>

    <div class="admin-card">
        <div class="admin-card-header">@lang('picks.season_heading')</div>
        <div class="admin-card-body">
            <div class="admin-form-group">
                <label for="picks_season_year">@lang('picks.setting_year')</label>
                <input type="number" id="picks_season_year" name="picks_season_year"
                       class="admin-input input-sm" autocomplete="off"
                       min="1900" max="2200" value="{{ $settings->seasonYear() }}">
                <div class="form-hint">@lang('picks.setting_year_note')</div>
            </div>

            <div class="admin-form-group">
                <label for="picks_conference">@lang('picks.setting_conference')</label>
                <select id="picks_conference" name="picks_conference" class="admin-input input-sm">
                    <option value="">@lang('picks.any_conference')</option>
