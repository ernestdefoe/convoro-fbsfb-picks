{#
    🚨 The first card says how this thing runs, and it goes first deliberately.

    Everything on the front end is a row a scheduled job wrote. Somebody who
    does not know that will press "Fetch now" and watch nothing happen, decide
    the extension is broken, and never look at the scheduled task runner — which
    is the actual thing that was wrong.

    🚨 No shell command anywhere on this screen. Convoro is administrable
    without a terminal; the honest thing is to point at the screen that already
    reports the runner.
#}
<div class="admin-card">
    <div class="admin-card-header">@lang('picks.how_it_works')</div>
    <div class="admin-card-body">
        <p class="admin-hint">@lang('picks.how_it_works_note')</p>
        <p class="admin-hint">@choice('picks.how_it_works_schedule', $callBudget)</p>
        <p class="admin-hint">@lang('picks.how_it_works_scores')</p>
        <p class="admin-hint">@lang('picks.how_it_works_cron')</p>
    </div>
</div>

<div class="admin-card">
    <div class="admin-card-header">@lang('picks.status_heading')</div>
    <div class="admin-card-body">
        @if($settings->fixturesStatus() === 'ok')
        <p><span class="badge badge-ok">@lang('picks.status_ok')</span> @lang('picks.status_ok_body')</p>
        @endif
        @if($settings->fixturesStatus() === 'unreachable')
        <p><span class="badge badge-lock">@lang('picks.status_unreachable')</span> @lang('picks.status_unreachable_body')</p>
        @endif
        @if($settings->fixturesStatus() === 'idle' || $settings->fixturesStatus() === 'unconfigured')
        <p><span class="badge badge-other">@lang('picks.status_idle')</span> @lang('picks.status_idle_body')</p>
        @endif
        @if($settings->fixturesStatus() === '')
        <p><span class="badge badge-other">@lang('picks.status_never')</span> @lang('picks.status_never_body')</p>
        @endif

        {#
            🚨 Four times, not two. "Last tried" and "last answered" are
            different facts and the gap between them is the whole diagnosis: a
            job that has run every hour and has not had an answer since Tuesday
            is a provider that is down, which is nothing like a job that has not
            run at all.
        #}
        <p class="form-hint">@lang('picks.status_fixtures_tried', ['when' => $fixturesAt])</p>
        <p class="form-hint">@lang('picks.status_fixtures_answered', ['when' => $fixturesOkAt])</p>
        <p class="form-hint">@lang('picks.status_scores_tried', ['when' => $scoresAt])</p>
        <p class="form-hint">@lang('picks.status_scores_answered', ['when' => $scoresOkAt])</p>

        @notempty($settings->fixturesError())
        <p class="form-hint">@lang('picks.status_reason', ['reason' => $settings->fixturesError()])</p>
        @endnotempty
        @notempty($settings->scoresError())
        <p class="form-hint">@lang('picks.status_reason', ['reason' => $settings->scoresError()])</p>
        @endnotempty

        <p class="admin-hint">@lang('picks.status_stale_note', ['minutes' => $staleMinutes])</p>
        <p class="admin-hint">@choice('picks.status_teams', $teamCount)</p>

