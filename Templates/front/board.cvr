@php
    /*
     * 🚨 The crest that suits the theme being rendered.
     *
     * ESPN publishes two: `500` is drawn for a light ground and `500-dark` is
     * the pale mark for a dark one, and Picks stores both — but the board only
     * ever used the light one, so on a dark theme every navy and black crest
     * sat invisible on a dark tile. The column was populated the whole time and
     * simply never read.
     *
     * Falls back either way, because a team synced before `logo_dark_path`
     * existed has only the one.
     */
    $crest = static function (array $team) use ($themeMode): string {
        $dark = ($themeMode ?? 'light') === 'dark';

        $preferred = $dark
            ? (string) ($team['logo_dark_path'] ?? '')
            : (string) ($team['logo_path'] ?? '');

        if (trim($preferred) !== '') {
            return $preferred;
        }

        return (string) ($team['logo_path'] ?? $team['logo_dark_path'] ?? '');
    };
@endphp

