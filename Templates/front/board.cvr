<div class="picks-list">
    @each ($games as $game)
    <div class="card picks-game">
        <div class="picks-meta">
            @if($game['open'])@lang('picks.locks', ['when' => $game['closes']])@endif
            @if(!$game['open'] && !$game['locked'])@lang('picks.locked')@endif
            @if($game['locked'])@lang('picks.kickoff', ['when' => $game['starts']])@endif
            @if($game['neutral']) &middot; @lang('picks.neutral_site')@endif

            {#
                🚨 Four states, and "not known" is a real one. It means the
                scoreboard has stopped answering, which is a different thing
                from a game that has not kicked off — and calling it either of
                those would be a claim nobody here can support.
            #}
            @if($game['state'] === 'live') &middot; <span class="badge badge-ok">@lang('picks.state_live')</span>@endif
            @if($game['state'] === 'final') &middot; <span class="badge">@lang('picks.state_final')</span>@endif
            @if($game['state'] === 'unknown') &middot; <span class="badge badge-lock">@lang('picks.state_unknown')</span>@endif
        </div>

        @if($game['state'] === 'unknown')
        <div class="picks-meta">@lang('picks.state_unknown_note')</div>
        @endif

        {#
            🚨 The team IS the button when the game is open.

            Asked for directly: *"I don't want to have to click pick home team
            or away team, I want to just click on the team to pick it."* Two
            named buttons underneath meant reading the tile, then finding the
            matching button — the thing being chosen and the control that chose
            it were different objects on the page.

            🚨 So the FORM wraps the teams, and each tile is a submit carrying
            its own side. The confidence select has to sit inside that same form
            and before them, because it is submitted by whichever tile is
            pressed.

            🚨 A link cannot live inside a button — the HTML is invalid and the
            browser will not let you click either. So the team's forum link is
            rendered only when the tile is NOT a button. That is a real loss on
            an open game, taken deliberately: picking is what somebody came to
            this page to do, and the same link is on every forum listing.
        #}
        @if($game['open'] && $mayPlay)
        <form method="POST" action="/picks/game/{{ $game['id'] }}" class="picks-form picks-form-teams">
            @csrf

            @if($confidence)
            <div class="picks-confidence">
                <label for="confidence-{{ $game['id'] }}">@lang('picks.confidence')</label>
                <select id="confidence-{{ $game['id'] }}" name="confidence" class="form-select input-xs">
                    <option value="">@lang('picks.confidence_none')</option>
                    @each ($confidenceRange as $level)
                    <option value="{{ $level }}" @if($game['mine'] !== null && $game['mine']['confidence'] === $level)selected @endif>{{ $level }}</option>
                    @endeach
                </select>
            </div>
            @endif

            <div class="picks-teams">
                @each ([['side' => 'away', 'team' => $game['away']], ['side' => 'home', 'team' => $game['home']]] as $entry)
                <button type="submit" name="outcome" value="{{ $entry['side'] }}"
                        class="picks-side picks-side-pick
                        @if($game['mine'] !== null && $game['mine']['selected_outcome'] === $entry['side'])picks-side-chosen @endif"
                        @if($game['mine'] !== null && $game['mine']['selected_outcome'] === $entry['side'])aria-pressed="true"@endif
                        title="@lang('picks.pick_this', ['team' => $entry['team']['name']])">

                    @notempty($crest($entry['team']))
                    <img class="picks-logo" src="{{ $crest($entry['team']) }}" alt="" loading="lazy" referrerpolicy="no-referrer">
                    @endnotempty

                    <span class="picks-name">{{ $entry['team']['name'] }}</span>

                    @if($game['shows_score'])
                    <span class="picks-score cv-tabular">{{ $entry['side'] === 'home' ? $game['home_score'] : $game['away_score'] }}</span>
                    @endif
                </button>
                @endeach
            </div>
        </form>

        @if($game['mine'] !== null)
        <form method="POST" action="/picks/game/{{ $game['id'] }}/withdraw" class="picks-form"
              onsubmit='return confirm(@json(__("picks.withdraw_confirm")))'>
            @csrf
            <button type="submit" class="btn btn-quiet btn-sm">@lang('picks.withdraw')</button>
        </form>
        @endif
        @endif

        {# Not open, or not allowed to play: the tile is a plain panel again,
           and the team's forum link comes back with it. #}
        @if(!$game['open'] || !$mayPlay)
        <div class="picks-teams">
            @each ([['side' => 'away', 'team' => $game['away']], ['side' => 'home', 'team' => $game['home']]] as $entry)
            <div class="picks-side
                @if($game['mine'] !== null && $game['mine']['selected_outcome'] === $entry['side'])picks-side-chosen @endif
                @if($game['result'] === $entry['side'] && $game['state'] === 'final')picks-side-correct @endif">

                @notempty($crest($entry['team']))
                <img class="picks-logo" src="{{ $crest($entry['team']) }}" alt="" loading="lazy" referrerpolicy="no-referrer">
                @endnotempty

                <span class="picks-name">
                    @notempty($entry['team']['forum_slug'])
                    <a href="/forum/{{ $entry['team']['forum_slug'] }}">{{ $entry['team']['name'] }}</a>
                    @endnotempty
                    @empty($entry['team']['forum_slug']){{ $entry['team']['name'] }}@endempty
                </span>

                @if($game['shows_score'])
                <span class="picks-score cv-tabular">{{ $entry['side'] === 'home' ? $game['home_score'] : $game['away_score'] }}</span>
                @endif
            </div>
            @endeach
        </div>
        @endif

        @if($confidence && $game['open'] && $mayPlay)
        <p class="picks-meta">@lang('picks.confidence_note')</p>
        @endif

        @if($game['mine'] !== null)
        <p class="picks-meta">
            @lang('picks.your_pick'):
            <strong>{{ $game['mine']['selected_outcome'] === 'home' ? $game['home']['name'] : $game['away']['name'] }}</strong>
            @if($confidence && $game['mine']['confidence'] !== null) &middot; @lang('picks.confidence') {{ $game['mine']['confidence'] }}@endif
            @if($game['mine']['is_correct'] === true) &middot; @lang('picks.outcome_correct')@endif
            @if($game['mine']['is_correct'] === false) &middot; @lang('picks.outcome_wrong')@endif
            @if($game['mine']['is_correct'] === null) &middot; @lang('picks.outcome_pending')@endif
        </p>
        @endif

        @if($game['mine'] === null && !$game['open'])
        <p class="picks-meta">@lang('picks.no_pick')</p>
        @endif

        {#
            🚨 Everybody's picks, and they are here ONLY because the service
            handed them over — which it does only once this game's cut-off has
            passed. Before that `$game['others']` is empty and this whole block
            renders the one honest sentence instead. The template does not
            decide; it could not, and it must not look as though it does.
        #}
        @if($game['locked'])
        <div>
            <div class="picks-meta">@lang('picks.everyone')</div>

            @empty($game['others'])
            <div class="picks-meta">@lang('picks.nobody_picked')</div>
            @endempty

            @notempty($game['others'])
            @notempty($game['tally'])
            <div class="picks-meta">@lang('picks.split', ['home' => $game['tally']['home'], 'away' => $game['tally']['away']])</div>
            @endnotempty

            <div class="picks-others">
                @each ($game['others'] as $other)
                <span class="picks-other">{{ $other['display_name'] }} —
                    {{ $other['selected_outcome'] === 'home' ? $game['home']['abbreviation'] : $game['away']['abbreviation'] }}@if($confidence && $other['confidence'] !== null) ({{ $other['confidence'] }})@endif</span>
                @endeach
            </div>
            @endnotempty
        </div>
        @endif

        @if(!$game['locked'])
        <p class="picks-meta">@lang('picks.hidden_until_cutoff')</p>
        @endif
    </div>
    @endeach
</div>

@endif
